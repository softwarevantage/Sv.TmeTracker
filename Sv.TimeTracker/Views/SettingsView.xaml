<UserControl x:Class="Sv.TimeTracker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,6,18,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Settings"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextFillColorPrimary}" />
                <TextBlock Text="Window behavior, chimes, and global hotkeys"
                           FontSize="12"
                           Foreground="{StaticResource TextFillColorSecondary}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding AppVersionDisplay}"
                       FontSize="12"
                       Foreground="{StaticResource TextFillColorTertiary}"
                       VerticalAlignment="Top"
                       Margin="0,4,0,0" />
        </Grid>

        <!-- Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Card -->
                <Border Style="{StaticResource FrostedCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="GENERAL &amp; WINDOW"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="Default Work Item on Startup"
                                   FontSize="12"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DefaultWorkItemOptions}"
                                  SelectedItem="{Binding SelectedDefaultWorkItem, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  Margin="0,0,0,10" />

                        <CheckBox Content="Always on Top (floating window)"
                                  IsChecked="{Binding TopmostEnabled, Mode=TwoWay}"
                                  Margin="0,2,0,6" />
                        <CheckBox Content="Minimize to System Tray instead of taskbar"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Margin="0,2,0,6" />
                        <CheckBox Content="Remember window size and screen position"
                                  IsChecked="{Binding PersistWindowBounds, Mode=TwoWay}"
                                  Margin="0,2,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Backdrop Opacity"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Margin="0,0,10,0" />
                            <Slider Grid.Column="1"
                                    Minimum="35"
                                    Maximum="100"
                                    Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center"
                                    ToolTip="Adjust frosted-glass transparency (35% = more transparent, 100% = solid)" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding BackgroundOpacityDisplay}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}"
                                       Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hourly Chime Card -->
                <Border Style="{StaticResource FrostedCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="HOURLY &amp; HALF-HOUR CHIME"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,8" />

                        <CheckBox Content="Play chime on the hour (:00) while timer is running"
                                  IsChecked="{Binding HourlyDingEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,6" />
                        <CheckBox Content="Also play chime on the half-hour (:30)"
                                  IsChecked="{Binding HalfHourDingEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding HourlyDingEnabled}"
                                  Margin="18,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Volume"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Margin="0,0,10,0" />
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding HourlyDingVolume, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VolumeDisplay}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}"
                                       Margin="6,0,8,0" />
                            <Button Grid.Column="3"
                                    Content="🔊 Test"
                                    Command="{Binding TestChimeCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,4" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SoundFileDisplay}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Command="{Binding BrowseSoundFileCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    Margin="6,0,4,0" />
                            <Button Grid.Column="2"
                                    Content="Reset"
                                    Command="{Binding ClearSoundFileCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Quiet Hours:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Height="28" />
                            <TextBlock Grid.Column="2"
                                       Text="to"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}"
                                       Margin="8,0,8,0" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Height="28" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Global Shortcuts Card -->
                <Border Style="{StaticResource FrostedCardStyle}" Margin="0,0,0,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="GLOBAL KEYBOARD SHORTCUTS"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextFillColorSecondary}" />
                            <Button Grid.Column="1"
                                    Content="Reset Defaults"
                                    Command="{Binding ResetDefaultHotkeysCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,3"
                                    FontSize="11" />
                        </Grid>

                        <CheckBox Content="Enable global hotkeys (works when minimized)"
                                  IsChecked="{Binding GlobalHotkeyEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start / Stop Timer" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ToggleTimerHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                     Height="28"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Click and press a shortcut combination" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Show / Hide Window" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ShowHideHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                     Height="28"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Click and press a shortcut combination" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Open Work Items" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding WorkItemsHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                     Height="28"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Click and press a shortcut combination" />
                        </Grid>

                        <TextBlock Text="{Binding HotkeyWarningsText}"
                                   FontSize="11.5"
                                   Foreground="#F59E0B"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HotkeyWarningsText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Data Storage Card -->
                <Border Style="{StaticResource FrostedCardStyle}" Margin="0,4,0,6">
                    <StackPanel>
                        <TextBlock Text="DATA STORAGE"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Local SQLite database (preserved across app upgrades):"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding DatabasePath, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Height="30"
                                     FontSize="11.5"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     ToolTip="{Binding DatabasePath}" />
                            <Button Grid.Column="1"
                                    Content="Open Folder"
                                    Command="{Binding OpenDatabaseFolderCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,4"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- About Card -->
                <Border Style="{StaticResource FrostedCardStyle}" Margin="0,4,0,6">
                    <StackPanel>
                        <TextBlock Text="ABOUT"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="pack://application:,,,/Assets/app-icon.png"
                                   Width="36"
                                   Height="36"
                                   Margin="0,0,12,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SV Time Tracker"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextFillColorPrimary}" />
                                    <TextBlock Text="{Binding AppVersionDisplay}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextFillColorSecondary}"
                                               VerticalAlignment="Bottom"
                                               Margin="8,0,0,1" />
                                </StackPanel>
                                <TextBlock Text="Software Vantage · Houston, Texas"
                                           FontSize="12"
                                           Foreground="{StaticResource TextFillColorSecondary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="🌐 www.softwarevantage.com"
                                    Command="{Binding OpenWebsiteCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,5"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Content="Check for Updates"
                                    Command="{Binding OpenReleasesCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,5"
                                    FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Save Bar -->
        <Grid Grid.Row="2" Margin="0,10,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,10,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1"
                    Content="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="148"
                    Height="38" />
        </Grid>
    </Grid>
</UserControl>
