<UserControl x:Class="Sv.TimeTracker.Views.WorkItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,6,18,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Work Items"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Text="Organize tasks and launch focused sessions"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ New Task"
                    Command="{Binding OpenNewEditorCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Inline Delete Confirmation Banner -->
        <Border Grid.Row="1"
                Background="{DynamicResource DangerBannerBackgroundBrush}"
                BorderBrush="{DynamicResource DangerBannerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="{Binding PendingDeleteItem, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <Run Text="Delete &quot;" /><Run Text="{Binding PendingDeleteItem.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="&quot; and its sessions?" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Delete"
                            Command="{Binding ConfirmDeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="10,4"
                            FontSize="12"
                            Margin="0,0,6,0" />
                    <Button Content="Cancel"
                            Command="{Binding CancelDeleteCommand}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Padding="10,4"
                            FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Work Items List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FrostedCardStyle}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Color Badge -->
                                <Ellipse Grid.Column="0"
                                         Width="12"
                                         Height="12"
                                         Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                         Margin="0,3,12,0"
                                         VerticalAlignment="Top" />

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding Description, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <Button Content="▶ Start"
                                            ToolTip="Select and start timer immediately"
                                            Command="{Binding DataContext.StartNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="10,5"
                                            FontSize="12"
                                            Margin="0,0,5,0" />
                                    <Button Content="Select"
                                            ToolTip="Select in Timer view"
                                            Command="{Binding DataContext.SetActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="8,5"
                                            FontSize="12"
                                            Margin="0,0,5,0" />
                                    <Button Content="✎"
                                            ToolTip="Edit work item"
                                            Command="{Binding DataContext.OpenEditEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="8,5"
                                            Margin="0,0,5,0" />
                                    <Button Content="🗑"
                                            ToolTip="Delete work item"
                                            Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="8,5" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Inline Frosted Create / Edit Modal Drawer -->
        <Border Grid.RowSpan="3"
                Background="{DynamicResource ModalOverlayBrush}"
                CornerRadius="12"
                Padding="20"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource FrostedCardStyle}"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding EditorHeader}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Title"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding DraftTitle, UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Description (optional)"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"
                             Height="56"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="8,6"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Badge Color"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectColorSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,8,0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Ellipse Fill="{Binding Converter={StaticResource HexColorToBrushConverter}}"
                                                     Stroke="{DynamicResource CardStrokeBrush}"
                                                     StrokeThickness="1.5" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="18"
                                 Height="18"
                                 Fill="{Binding DraftColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBox Text="{Binding DraftColor, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding EditorValidationError}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               Margin="0,0,0,10"
                               Visibility="{Binding EditorValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditorCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="84"
                                Margin="0,0,8,0" />
                        <Button Content="Save Task"
                                Command="{Binding SaveEditorCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="104" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
