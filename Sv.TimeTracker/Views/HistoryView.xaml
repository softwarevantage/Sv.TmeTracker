<UserControl x:Class="Sv.TimeTracker.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,6,18,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header + Presets + Export -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="History"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           Margin="0,0,12,0" />
                <Button Content="Today"
                        Command="{Binding ApplyPresetCommand}"
                        CommandParameter="Today"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,4"
                        FontSize="11.5"
                        Margin="0,0,4,0" />
                <Button Content="Week"
                        Command="{Binding ApplyPresetCommand}"
                        CommandParameter="Week"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,4"
                        FontSize="11.5"
                        Margin="0,0,4,0" />
                <Button Content="Month"
                        Command="{Binding ApplyPresetCommand}"
                        CommandParameter="Month"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,4"
                        FontSize="11.5"
                        Margin="0,0,4,0" />
                <Button Content="All"
                        Command="{Binding ApplyPresetCommand}"
                        CommandParameter="All"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,4"
                        FontSize="11.5" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="⬇ Export CSV"
                    Command="{Binding ExportCsvCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Padding="12,6"
                    FontSize="12.5" />
        </Grid>

        <!-- Row 1: Date Range & Work Item Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <DatePicker Grid.Column="0"
                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                        Margin="0,0,6,0"
                        ToolTip="Start Date" />
            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                        Margin="0,0,6,0"
                        ToolTip="End Date" />
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding WorkItemOptions}"
                      SelectedItem="{Binding SelectedWorkItemOption, Mode=TwoWay}"
                      DisplayMemberPath="Title"
                      ToolTip="Filter by Work Item" />
        </Grid>

        <!-- Row 2: KPI Summary Strip -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,10">
            <Border Style="{StaticResource FrostedCardStyle}" Padding="10,8" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="TOTAL TRACKED"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding GrandTotalFormatted}"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FrostedCardStyle}" Padding="10,8" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="SESSIONS"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalSessionCount}"
                               FontSize="15.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FrostedCardStyle}" Padding="10,8" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="TOP FOCUS"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding TopWorkItemSummary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Row 3: Section Switcher + Status -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Sessions"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="Entries"
                        Margin="0,0,6,0"
                        Padding="12,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEntriesSection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ActivePillBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="By Task"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="WorkItems"
                        Margin="0,0,6,0"
                        Padding="12,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkItemsSection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ActivePillBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="By Day"
                        Command="{Binding SelectSectionCommand}"
                        CommandParameter="Days"
                        Padding="12,5">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDaysSection}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ActivePillBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       FontSize="11.5"
                       Foreground="{DynamicResource SuccessBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Row 4: Section Lists -->
        <Grid Grid.Row="4">
            <!-- SESSIONS LIST -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEntriesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FrostedCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActivelyRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RunningCardTintBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource RunningCardBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PausedCardTintBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PausedCardBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="{Binding WorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                             Margin="0,4,10,0"
                                             VerticalAlignment="Top" />

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WorkItemTitle}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <!-- Live / Paused Status Pill -->
                                            <Border CornerRadius="8"
                                                    Padding="7,2"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource RunningBadgeBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PausedBadgeBackgroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding ActiveStatusBadgeText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TimeRangeDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Notes}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource NotesTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding Notes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DurationFormatted}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActivelyRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding CanEditOrDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="✎"
                                                    ToolTip="Edit session time and notes"
                                                    Command="{Binding DataContext.BeginEditEntryNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Padding="6,2"
                                                    FontSize="11"
                                                    Margin="0,0,4,0" />
                                            <Button Content="🗑"
                                                    ToolTip="Delete time entry"
                                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Padding="6,2"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- WORK ITEM TOTALS WITH PROGRESS BARS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsWorkItemsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding WorkItemTotals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FrostedCardStyle}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="10"
                                                 Height="10"
                                                 Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ShareDisplay}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TotalFormatted}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Bar Track -->
                                    <Border Background="{DynamicResource ProgressTrackBrush}"
                                            Height="7"
                                            CornerRadius="3.5"
                                            Margin="0,8,0,0">
                                        <Border HorizontalAlignment="Left"
                                                Height="7"
                                                CornerRadius="3.5"
                                                Width="{Binding ShareRatio, Converter={StaticResource RatioToWidthConverter}, ConverterParameter=390}"
                                                Background="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- DAILY TOTALS -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsDaysSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding DailyTotals}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FrostedCardStyle}" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding EntryCountDisplay}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalFormatted}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Typography.NumeralAlignment="Tabular"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Inline Session Edit Overlay -->
        <Border Grid.RowSpan="5"
                Background="{DynamicResource ModalOverlayBrush}"
                CornerRadius="12"
                Padding="20"
                Visibility="{Binding EditingEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource FrostedCardStyle}"
                    Background="{DynamicResource ModalSurfaceBrush}"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{Binding EditingEntry.WorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Edit Session"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EditingEntry.WorkItemTitle, StringFormat=' · {0}'}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Start Date & Time -->
                    <TextBlock Text="START"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0"
                                    SelectedDate="{Binding EditingStartDate, Mode=TwoWay}"
                                    Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding EditingStartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 ToolTip="Start time (e.g. 09:00:00 or 9:00 AM)" />
                    </Grid>

                    <!-- End Date & Time -->
                    <TextBlock Text="END"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0"
                                    SelectedDate="{Binding EditingEndDate, Mode=TwoWay}"
                                    Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding EditingEndTimeText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 ToolTip="End time (e.g. 17:30:00 or 5:30 PM)" />
                    </Grid>

                    <!-- Duration -->
                    <TextBlock Text="DURATION (HH:MM:SS)"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditingDurationText, UpdateSourceTrigger=PropertyChanged}"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             Margin="0,0,0,10"
                             ToolTip="Duration in HH:MM:SS (updating adjusts End time)" />

                    <!-- Notes -->
                    <TextBlock Text="NOTES"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditingEntryNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="62"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="8,6"
                             Margin="0,0,0,10" />

                    <TextBlock Text="{Binding EditingValidationError}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Visibility="{Binding EditingValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelEditEntryNotesCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="80"
                                Margin="0,0,8,0" />
                        <Button Content="Save"
                                Command="{Binding SaveEntryNotesCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="88" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
