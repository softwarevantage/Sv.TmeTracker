<UserControl x:Class="Sv.TimeTracker.Controls.MainTimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,6,18,10">
        <!-- Standard Full Mode -->
        <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero Timer Card -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Active Work Item Pill -->
                <Border Background="{DynamicResource SubtleButtonBackgroundBrush}"
                        BorderBrush="{DynamicResource SubtleButtonBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,5"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{Binding ActiveWorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveWorkItemTitle}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Elapsed Tabular Time -->
                <TextBlock Text="{Binding ElapsedText}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="{StaticResource TimerFontSize}"
                           FontWeight="Light"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" />

                <!-- Start / Pause / Stop & Switch Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <!-- Pause / Resume Button (visible while session is active) -->
                    <Button Content="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="130"
                            Height="{StaticResource ButtonHeight}"
                            FontSize="14.5"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{DynamicResource PausedButtonBackgroundBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsPaused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PausedButtonHoverBrush}" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsPaused}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ResumeButtonHoverBrush}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ResumeButtonBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Start / Stop Button -->
                    <Button Content="{Binding ToggleButtonText}"
                            Command="{Binding ToggleTimerCommand}"
                            Height="{StaticResource ButtonHeight}"
                            FontSize="15">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Width" Value="{StaticResource ButtonWidth}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                        <Setter Property="Width" Value="130" />
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Switch Task"
                            Command="{Binding SwitchActiveWorkItemCommand}"
                            Visibility="{Binding CanSwitchToSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Margin="10,0,0,0" />
                </StackPanel>

                <!-- Inline Validation Feedback -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Work Item Selector + Quick Create Card -->
            <Border Grid.Row="1" Style="{StaticResource FrostedCardStyle}" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock Text="ACTIVE WORK ITEM"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,6" />

                    <ComboBox x:Name="WorkItemSelector"
                              ItemsSource="{Binding WorkItems}"
                              SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                              Height="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Quick Add Work Item Row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding QuickWorkItemTitle, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="QuickAddTextBox_KeyDown"
                                 VerticalContentAlignment="Center"
                                 Height="32"
                                 Padding="8,0"
                                 ToolTip="Type a new work item name and press Enter" />
                        <Button Grid.Column="1"
                                Content="+ Quick Add"
                                Command="{Binding QuickAddWorkItemCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Height="32"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Session Notes Card -->
            <Border Grid.Row="2" Style="{StaticResource FrostedCardStyle}">
                <StackPanel>
                    <TextBlock Text="SESSION NOTES"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding SessionNotes, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="SessionNotes_LostFocus"
                             Height="48"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="8,6"
                             ToolTip="Optional notes saved with this time entry" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Compact Mini-Timer HUD Mode -->
        <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}}"
              VerticalAlignment="Center"
              Margin="-4,0,-4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="74" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="30"
                               FontWeight="Light"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{Binding ActiveWorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActiveWorkItemTitle}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <!-- Vertically Stacked Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <Button Content="{Binding CompactPauseIcon}"
                            ToolTip="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="84"
                            Height="34"
                            Padding="0"
                            FontSize="14"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{DynamicResource PausedButtonBackgroundBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsPaused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PausedButtonHoverBrush}" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsPaused}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ResumeButtonHoverBrush}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ResumeButtonBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding ToggleTimerCommand}"
                            Width="84"
                            Height="34"
                            Padding="0"
                            FontSize="13.5"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Content" Value="Start" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                        <Setter Property="Content" Value="Stop" />
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding WorkItems}"
                      SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                      Height="32"
                      Margin="0,10,0,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </Grid>
</UserControl>
