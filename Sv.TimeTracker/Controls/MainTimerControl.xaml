<UserControl x:Class="Sv.TimeTracker.Controls.MainTimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,6,18,10">
        <!-- Standard Full Mode -->
        <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero Timer Card -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Active Work Item Pill -->
                <Border Background="#1FFFFFFF"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,5"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{Binding ActiveWorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveWorkItemTitle}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextFillColorPrimary}"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Elapsed Tabular Time -->
                <TextBlock Text="{Binding ElapsedText}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="{StaticResource TimerFontSize}"
                           FontWeight="Light"
                           Typography.NumeralAlignment="Tabular"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextFillColorPrimary}" />

                <!-- Start / Pause / Stop & Switch Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <!-- Pause / Resume Button (visible while session is active) -->
                    <Button Content="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="130"
                            Height="{StaticResource ButtonHeight}"
                            FontSize="14.5"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#D97706" />
                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Start / Stop Button -->
                    <Button Content="{Binding ToggleButtonText}"
                            Command="{Binding ToggleTimerCommand}"
                            Height="{StaticResource ButtonHeight}"
                            FontSize="15">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Width" Value="{StaticResource ButtonWidth}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                        <Setter Property="Width" Value="130" />
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Switch Task"
                            Command="{Binding SwitchActiveWorkItemCommand}"
                            Visibility="{Binding CanSwitchToSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Margin="10,0,0,0" />
                </StackPanel>

                <!-- Inline Validation Feedback -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Work Item Selector + Quick Create Card -->
            <Border Grid.Row="1" Style="{StaticResource FrostedCardStyle}" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock Text="ACTIVE WORK ITEM"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextFillColorSecondary}"
                               Margin="0,0,0,6" />

                    <ComboBox x:Name="WorkItemSelector"
                              ItemsSource="{Binding WorkItems}"
                              SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                              Height="36">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Quick Add Work Item Row -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding QuickWorkItemTitle, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="QuickAddTextBox_KeyDown"
                                 VerticalContentAlignment="Center"
                                 Height="32"
                                 Padding="8,0"
                                 ToolTip="Type a new work item name and press Enter" />
                        <Button Grid.Column="1"
                                Content="+ Quick Add"
                                Command="{Binding QuickAddWorkItemCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Height="32"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Session Notes Card -->
            <Border Grid.Row="2" Style="{StaticResource FrostedCardStyle}">
                <StackPanel>
                    <TextBlock Text="SESSION NOTES"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextFillColorSecondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding SessionNotes, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="SessionNotes_LostFocus"
                             Height="48"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Padding="8,6"
                             ToolTip="Optional notes saved with this time entry" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Compact Mini-Timer HUD Mode -->
        <Grid Visibility="{Binding IsCompactMode, Converter={StaticResource BooleanToVisibilityConverter}}"
              VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ElapsedText}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="36"
                               FontWeight="Light"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextFillColorPrimary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ActiveWorkItemColor, Converter={StaticResource HexColorToBrushConverter}}"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveWorkItemTitle}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextFillColorSecondary}"
                                   MaxWidth="240"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding CompactPauseIcon}"
                            ToolTip="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Visibility="{Binding HasActiveSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="44"
                            Height="40"
                            Padding="0"
                            FontSize="15"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#D97706" />
                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="{Binding ToggleButtonText}"
                            Command="{Binding ToggleTimerCommand}"
                            Height="40"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Width" Value="124" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                        <Setter Property="Width" Value="84" />
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <ComboBox Grid.Row="1"
                      ItemsSource="{Binding WorkItems}"
                      SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                      Height="32"
                      Margin="0,12,0,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding Color, Converter={StaticResource HexColorToBrushConverter}}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </Grid>
</UserControl>
